---
const links=[['Projects','/thelist'],['Photos','/photography'],['Résumé','/resume.pdf'],['Contact','/contact']];
---
<header class="site-nav"><a class="site-wordmark" href="/"><img src="/profile.png" width="34" height="34" alt=""/>Bryan Hu</a><nav aria-label="Main navigation">{links.map(([label,href])=><a href={href} aria-current={Astro.url.pathname.replace(/\/$/,'')===href?'page':undefined}>{label}</a>)}</nav></header>
<style>
.site-nav{position:fixed;inset:0 0 auto;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:102px;padding:20px 4%;background:#fffefbf5;border-bottom:1px solid #17203620;color:#172036;}
.site-wordmark{display:flex;align-items:center;gap:10px;font:26px var(--font-sketch);}.site-wordmark img{border:1px solid #172036;border-radius:6px;}nav{display:flex;gap:26px;font:19px var(--font-sketch);}nav a{white-space:nowrap;}nav a:hover,nav a[aria-current]{color:#3473ff;text-decoration:underline;text-underline-offset:5px;}
@media(max-width:760px){.site-nav{align-items:flex-start;flex-direction:column;gap:10px;padding:14px 7%;}.site-wordmark{font-size:23px;}.site-wordmark img{width:28px;height:28px;}nav{gap:8px;font-size:15px;width:100%;justify-content:space-between;}}
</style>
