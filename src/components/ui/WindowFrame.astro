---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Desktop counterpart to PhoneFrame. The title bar is real chrome, not
// decoration: it tells you at a glance that this is a Mac app rather than a
// web page, which is the whole point of Quillium being local-first.
interface Props {
    src: ImageMetadata;
    alt: string;
    title?: string;
    class?: string;
}

const { src, alt, title, class: className } = Astro.props;
---

<div
    class:list={[
        "relative overflow-hidden rounded-xl border border-white/[0.12] bg-surface-2 shadow-[0_60px_120px_-40px_rgba(0,0,0,0.95),0_12px_36px_-12px_rgba(0,0,0,0.7)]",
        className,
    ]}
>
    <div
        class="flex items-center gap-2 border-b border-white/[0.08] bg-surface-3/80 px-4 py-2.5"
    >
        <span class="size-[0.6875rem] rounded-full bg-[#5b5b60]"></span>
        <span class="size-[0.6875rem] rounded-full bg-[#4a4a4f]"></span>
        <span class="size-[0.6875rem] rounded-full bg-[#3d3d42]"></span>
        {
            title && (
                <span class="ml-2 truncate text-[0.75rem] text-fg-dim">
                    {title}
                </span>
            )
        }
    </div>
    <Image
        src={src}
        alt={alt}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 768px) 56vw, calc(100vw - 2.5rem)"
        draggable="false"
        class="block h-auto w-full select-none"
    />
    <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 rounded-xl bg-linear-to-b from-white/[0.07] via-transparent to-transparent"
    >
    </div>
</div>
