<div class="playable-trombone" aria-label="Interactive trombone">
 <svg viewBox="0 0 500 140" fill="none" aria-hidden="true" style="width:100%;height:110px;overflow:visible">
  <defs>
   <linearGradient id="trombone-brass" x1="0%" y1="0%" x2="0%" y2="100%"><stop stop-color="#8f612b"/><stop offset=".22" stop-color="#e9c778"/><stop offset=".44" stop-color="#fff1bc"/><stop offset=".65" stop-color="#d3a24e"/><stop offset="1" stop-color="#996628"/></linearGradient>
   <linearGradient id="trombone-bell" x1="0%" y1="0%" x2="0%" y2="100%"><stop stop-color="#b9873e"/><stop offset=".3" stop-color="#f0d495"/><stop offset=".5" stop-color="#fff3c8"/><stop offset=".7" stop-color="#cf9d4d"/><stop offset="1" stop-color="#8d5e2a"/></linearGradient>
  </defs>
  <g stroke-linecap="round" stroke-linejoin="round">
   <!-- The tuning bow sits behind the player; bell and hand slide face forward. -->
   <path d="M165 86H44C8 86 8 43 44 43H156" stroke="#594328" stroke-width="9"/>
   <path d="M165 86H44C8 86 8 43 44 43H156" stroke="url(#trombone-brass)" stroke-width="6"/>
   <path d="M128 39C176 39 211 39 236 34C254 30 269 19 279 8L279 78C263 63 251 57 234 53C208 47 174 47 128 47Z" fill="url(#trombone-bell)" stroke="#73512d" stroke-width="1.5"/>
   <ellipse cx="279" cy="43" rx="7" ry="35" fill="#9e713a" stroke="#6b4c2c" stroke-width="1.5"/>
   <ellipse cx="280" cy="43" rx="3.5" ry="30" fill="#3e3023"/>
   <path d="M148 41Q247 44 271 17" stroke="#fff1bf" stroke-width="1.5"/>
   <path d="M83 47V81" stroke="#8f6b35" stroke-width="4"/>
   <circle cx="83" cy="65" r="7" fill="#d5b775" stroke="#73512d" stroke-width="1.3"/>
   <!-- Mouthpiece enters the upper slide tube; lower tube returns to the bell. -->
   <path d="M95 101H352M129 123H352" stroke="#68717a" stroke-width="4"/>
   <path d="M95 100H352M129 122H352" stroke="#edf0f2" stroke-width="1.5"/>
   <path d="M152 123V93Q152 86 160 86H166" stroke="#73512d" stroke-width="6"/>
   <path d="M152 123V93Q152 86 160 86H166" stroke="#d6af66" stroke-width="3.5"/>
   <path d="M129 101V123" stroke="#b49763" stroke-width="4"/>
   <path d="M97 98H86L80 94H74V108H80L86 104H97Z" fill="#dce0e3" stroke="#68717a" stroke-width="1.2"/>
   <g class="trombone-slide">
    <path d="M166 101H404Q415 101 415 112T404 123H166" stroke="#705431" stroke-width="6"/>
    <path d="M166 101H404Q415 101 415 112T404 123H166" stroke="url(#trombone-brass)" stroke-width="4"/>
    <path d="M173 100H402M173 122H402" stroke="#fff0b5" stroke-width=".8"/>
    <path d="M183 102V122" stroke="#967846" stroke-width="4"/>
    <path d="M183 103V121" stroke="#f2d498" stroke-width="1.5"/>
    <path d="M166 98V104M166 120V126M172 98V104M172 120V126" stroke="#8c744b" stroke-width="1.5"/>
    <path d="M401 127L406 132M400 132H410" stroke="#836f50" stroke-width="1.5"/>
   </g>
  </g>
 </svg>
 <div class="instrument-panel">
  <div class="instrument-top"><button type="button" class="trombone-play" aria-pressed="false">Play ♫</button><output aria-live="off">B♭3</output></div>
  <div class="trombone-controls"><label for="trombone-slide">Slide</label><input id="trombone-slide" type="range" min="0" max="6" step="0.01" value="0" aria-label="Trombone slide position"/></div>
  <div class="partial-controls"><span>Partial</span><div class="partial-stepper"><button type="button" class="partial-down" aria-label="Lower partial">−</button><span class="partial-label" aria-live="polite">4</span><button type="button" class="partial-up" aria-label="Higher partial">+</button></div></div>
 </div>
 <p>Drag the slide to play, or hold Play.</p>
 <small>This is not indicative of my actual playing range.</small>
</div>
<script>
const instrument=document.querySelector<HTMLElement>('.playable-trombone');
if(instrument){
 const button=instrument.querySelector<HTMLButtonElement>('button')!;
 const slider=instrument.querySelector<HTMLInputElement>('input')!;
 const slide=instrument.querySelector<SVGGElement>('.trombone-slide')!;
 const output=instrument.querySelector('output')!;
 let partial=4;
 const down=instrument.querySelector<HTMLButtonElement>('.partial-down')!;
 const up=instrument.querySelector<HTMLButtonElement>('.partial-up')!;
 const partialLabel=instrument.querySelector<HTMLElement>('.partial-label')!;
 const notes=['C','D♭','D','E♭','E','F','G♭','G','A♭','A','B♭','B'];
 function noteName(frequency:number){const midi=Math.round(69+12*Math.log2(frequency/440));return notes[midi%12]+(Math.floor(midi/12)-1);}
 let context:AudioContext|undefined;
 let voice:{osc:OscillatorNode;gain:GainNode;filter:BiquadFilterNode}|undefined;
 let releaseTimer:ReturnType<typeof setTimeout>|undefined;
 function pitch(){return 58.27047*partial*Math.pow(2,-Number(slider.value)/12);}
 function stop(){
  clearTimeout(releaseTimer);
  if(voice&&context){const old=voice;voice=undefined;const now=context.currentTime;old.gain.gain.cancelScheduledValues(now);old.gain.gain.setTargetAtTime(0,now,.035);old.osc.stop(now+.2);old.osc.onended=()=>{old.osc.disconnect();old.gain.disconnect();old.filter.disconnect();};}
  button.setAttribute('aria-pressed','false');instrument.classList.remove('playing');
 }
 function play(){
  if(voice)return;
  context??=new AudioContext();void context.resume();
  const osc=context.createOscillator(),gain=context.createGain(),filter=context.createBiquadFilter();
  osc.type='sawtooth';osc.frequency.value=pitch();filter.type='lowpass';filter.frequency.value=1400;filter.Q.value=.6;
  osc.connect(filter);filter.connect(gain);gain.connect(context.destination);
  gain.gain.setValueAtTime(0,context.currentTime);gain.gain.linearRampToValueAtTime(.09,context.currentTime+.08);osc.start();voice={osc,gain,filter};
  button.setAttribute('aria-pressed','true');instrument.classList.add('playing');releaseTimer=setTimeout(stop,10000);
 }
 button.addEventListener('pointerdown',event=>{if(event.button!==0)return;event.preventDefault();button.setPointerCapture(event.pointerId);play();});
 button.addEventListener('pointerup',stop);button.addEventListener('pointercancel',stop);button.addEventListener('lostpointercapture',stop);
 button.addEventListener('keydown',event=>{if([' ','Enter'].includes(event.key)){event.preventDefault();if(!event.repeat)play();}});
 button.addEventListener('keyup',event=>{if([' ','Enter'].includes(event.key)){event.preventDefault();stop();}});
 button.addEventListener('click',event=>{if(event.detail===0&&!voice){play();clearTimeout(releaseTimer);releaseTimer=setTimeout(stop,650);}});
 slider.addEventListener('pointerdown',play);
 slider.addEventListener('pointerup',stop);slider.addEventListener('pointercancel',stop);
 slider.addEventListener('keydown',event=>{if(event.key.startsWith('Arrow'))play();});slider.addEventListener('keyup',stop);
 function updatePitch(){
  slide.setAttribute('transform',`translate(${Number(slider.value)*10} 0)`);
  output.textContent=noteName(pitch());
  partialLabel.textContent=String(partial);
  down.disabled=partial===2;up.disabled=partial===6;
  if(context&&voice)voice.osc.frequency.setTargetAtTime(pitch(),context.currentTime,.025);
 }
 slider.addEventListener('input',updatePitch);
 down.addEventListener('click',()=>{partial=Math.max(2,partial-1);updatePitch();});
 up.addEventListener('click',()=>{partial=Math.min(6,partial+1);updatePitch();});
 updatePitch();
 window.addEventListener('blur',stop);
 const visibility=()=>{if(document.hidden)stop();};document.addEventListener('visibilitychange',visibility);
 const observer=new IntersectionObserver(entries=>{if(!entries[0].isIntersecting)stop();});observer.observe(instrument);
 document.addEventListener('astro:before-swap',()=>{stop();observer.disconnect();window.removeEventListener('blur',stop);document.removeEventListener('visibilitychange',visibility);void context?.close();},{once:true});
}
</script>
<style>
.playable-trombone{width:310px;max-width:100%;margin-top:22px;}
.instrument-panel{display:grid;gap:14px;padding:18px 20px;margin-top:12px;border:1px solid #17203625;border-radius:12px 5px 10px 5px;background:#f5f7ff;}
.instrument-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:2px;}
.trombone-play{font:18px var(--font-sketch);border:1px solid #172036;border-radius:4px 8px 3px 5px;padding:4px 14px;background:#fffefb;touch-action:none;user-select:none;cursor:pointer;}
.playing .trombone-play{background:#3473ff;color:white;}
output{font:24px var(--font-sketch);color:#3473ff;min-width:48px;text-align:right;}
.trombone-controls,.partial-controls{display:grid;grid-template-columns:55px 1fr;align-items:center;gap:12px;font:16px var(--font-sketch);}
input{width:100%;min-width:0;margin:0;accent-color:#3473ff;}
.partial-stepper{display:flex;align-items:center;justify-content:space-between;}
.partial-stepper button{border:1px solid #17203640;border-radius:5px;background:#fffefb;width:32px;height:30px;font:20px var(--font-sketch);cursor:pointer;}
.partial-stepper button:disabled{opacity:.3;cursor:default;}
button:focus-visible,input:focus-visible{outline:2px solid #3473ff;outline-offset:3px;}
.partial-label{text-align:center;color:#3473ff;}
p{font:14px var(--font-sketch);color:#515b6e;margin:12px 0 0;}
small{display:block;font-size:10px;line-height:1.5;color:#515b6e;margin-top:6px;}
@media(max-width:760px){.playable-trombone{width:280px;margin-top:10px;}.playable-trombone svg{height:55px!important;}.instrument-panel{padding:14px 16px;gap:10px;margin-top:10px;}}
</style>
