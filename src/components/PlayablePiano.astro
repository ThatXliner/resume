---
const whites=[0,2,4,5,7,9,11,12,14,16,17,19,21,23];
const names=['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
const shortcuts=['a','w','s','e','d','f','t','g','y','h','u','j','k','o','l','p',';'];
---
<div class="playable-piano">
 <div class="piano-notes" aria-hidden="true">♫ <span>♪</span></div>
 <div class="piano-keys" role="group" aria-label="Playable piano, C4 to B5">
 {whites.map((note,i)=><button class="piano-key white" type="button" data-note={note} aria-label={`${names[note%12]}${4+Math.floor(note/12)}${shortcuts[note] ? `, keyboard ${shortcuts[note]}` : ''}`} style={`left:${i/14*100}%;width:${100/14}%`}></button>)}
 {whites.flatMap((note,i)=>[0,2,5,7,9].includes(note%12)?[<button class="piano-key black" type="button" data-note={note+1} aria-label={`${names[(note+1)%12]}${4+Math.floor(note/12)}${shortcuts[note+1] ? `, keyboard ${shortcuts[note+1]}` : ''}`} style={`left:${(i+.72)/14*100}%;width:${.56/14*100}%`}></button>]:[])}
 </div>
 <p class="piano-help">Play a little. <span>Tap the keys, or try A S D F G H J.</span></p>
</div>
<script>
const piano=document.querySelector<HTMLElement>('.playable-piano');
if(piano){
 let context:AudioContext|undefined;
 const keys=[...piano.querySelectorAll<HTMLButtonElement>('[data-note]')];
 const shortcuts=['a','w','s','e','d','f','t','g','y','h','u','j','k','o','l','p',';'];
 const timers=new Map<HTMLElement,ReturnType<typeof setTimeout>>();
 function play(key:HTMLButtonElement){
  context??=new AudioContext();
  void context.resume();
  const now=context.currentTime,frequency=261.625565*Math.pow(2,Number(key.dataset.note)/12);
  const envelope=context.createGain();envelope.connect(context.destination);
  envelope.gain.setValueAtTime(0,now);envelope.gain.linearRampToValueAtTime(.17,now+.008);envelope.gain.exponentialRampToValueAtTime(.0001,now+1.8);
  [1,2,3,4].forEach((partial,i)=>{const oscillator=context!.createOscillator();const gain=context!.createGain();oscillator.type='sine';oscillator.frequency.value=frequency*partial;gain.gain.value=[1,.3,.12,.04][i];oscillator.connect(gain);gain.connect(envelope);oscillator.start(now);oscillator.stop(now+1.85);oscillator.onended=()=>{oscillator.disconnect();gain.disconnect();if(i===3)envelope.disconnect();};});
  key.classList.add('is-playing');clearTimeout(timers.get(key));timers.set(key,setTimeout(()=>{key.classList.remove('is-playing');timers.delete(key);},180));
 }
 keys.forEach(key=>{
  key.addEventListener('pointerdown',event=>{if(event.button===0){event.preventDefault();key.focus({preventScroll:true});play(key);}});
  key.addEventListener('click',event=>{if(event.detail===0)play(key);});
 });
 const onKey=(event:KeyboardEvent)=>{
  if(event.repeat||event.ctrlKey||event.metaKey||event.altKey)return;
  const target=event.target as HTMLElement;if(target.matches('input,textarea,select')||target.isContentEditable)return;
  const bounds=piano.getBoundingClientRect();if(bounds.bottom<0||bounds.top>innerHeight)return;
  const note=shortcuts.indexOf(event.key.toLowerCase());if(note<0)return;
  const key=keys.find(key=>Number(key.dataset.note)===note);if(key){event.preventDefault();play(key);}
 };
 document.addEventListener('keydown',onKey);
 document.addEventListener('astro:before-swap',()=>{document.removeEventListener('keydown',onKey);timers.forEach(clearTimeout);void context?.close();},{once:true});
}
</script>
<style>
.playable-piano{margin:25px 0 35px;max-width:470px;}.piano-notes{font:48px var(--font-sketch);padding-left:20%;height:66px;}.piano-notes span{margin-left:32%;}.piano-keys{position:relative;height:120px;transform:rotate(-.7deg);border:2px solid #172036;border-radius:3px 5px 2px 4px;}.piano-key{position:absolute;top:0;padding:0;cursor:pointer;touch-action:manipulation;border-radius:1px 2px 3px 2px;}.white{height:100%;background:#fffefb;border:0;border-right:1.5px solid #172036;}.black{height:65%;background:#172036;border:1px solid #172036;z-index:1;}.white.is-playing{background:#b8cfff;}.black.is-playing{background:#3473ff;}.piano-key:focus-visible{outline:3px solid #e7a3ad;outline-offset:-3px;}.piano-help{font:18px var(--font-sketch);color:#3473ff;margin-top:14px;}.piano-help span{color:#515b6e;font-size:15px;}@media(max-width:760px){.piano-keys{height:105px;}.piano-help span{display:block;}}
</style>
