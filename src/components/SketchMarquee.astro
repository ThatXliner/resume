---
import type { getAllRepositories } from '../lib/github';
interface Props { repositories: Awaited<ReturnType<typeof getAllRepositories>>; }
const { repositories } = Astro.props;
const rows = [0, 1].map(parity => repositories.filter(repo => repo.starCount >= 2 && !['ThatXliner', 'dotfiles'].includes(repo.name)).filter((repo, index) => index % 2 === parity));
---
<div class="sketch-marquee">
  <div class="sketch-marquee-heading"><span>A few more things I’ve made</span><button type="button" aria-pressed="false" aria-label="Pause repository scrolling">Pause</button></div>
  {rows.map((row, index) => <div class="sketch-marquee-row" tabindex="0" role="region" aria-label={`More repositories, row ${index + 1}`}>
    {[0, 1].map(copy => <div class="sketch-marquee-copy" aria-hidden={copy === 1 ? 'true' : undefined}>
      {row.map(repo => <a href={`https://github.com/ThatXliner/${repo.name}`} tabindex={copy === 1 ? -1 : undefined}>
        <strong>{repo.name} <span aria-hidden="true">↗</span></strong><p>{repo.body}</p><small>{repo.language && <span class="sketch-language" style={`--language-color:${repo.languageColor || '#515b6e'}`}>{repo.language}</span>} <span>☆ {repo.starCount}</span></small>
      </a>)}
    </div>)}
  </div>)}
</div>
<script>
  document.querySelectorAll<HTMLElement>('.sketch-marquee').forEach(marquee => {
    const button = marquee.querySelector('button')!;
    button.addEventListener('click', () => {
      const paused = marquee.toggleAttribute('data-paused');
      button.setAttribute('aria-pressed', String(paused));
      button.setAttribute('aria-label', `${paused ? 'Resume' : 'Pause'} repository scrolling`);
      button.textContent = paused ? 'Resume' : 'Pause';
      if (!paused) marquee.querySelectorAll<HTMLElement>('[data-manual]').forEach(row => {
        row.removeAttribute('data-manual');
        row.scrollLeft = 0;
      });
    });
    marquee.querySelectorAll<HTMLElement>('.sketch-marquee-row').forEach(row => {
      const manual = () => {
        row.setAttribute('data-manual', '');
        marquee.setAttribute('data-paused', '');
        button.setAttribute('aria-pressed', 'true');
        button.setAttribute('aria-label', 'Resume repository scrolling');
        button.textContent = 'Resume';
      };
      row.addEventListener('focusin', manual);
      row.addEventListener('pointerdown', manual);
    });
  });
</script>
<style is:global>
.sketch-marquee { margin-top: 42px; min-width: 0; }
.sketch-marquee-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:16px; font:20px var(--font-sketch); color:var(--accent); }
.sketch-marquee-heading button { font:16px var(--font-sketch); color:var(--ink); background:transparent; border:1px solid currentColor; border-radius:3px 7px 2px 5px; padding:3px 10px; cursor:pointer; }
.sketch-marquee-row { display:flex; overflow:hidden; margin:0 0 14px; padding:5px 0; }
.sketch-marquee-copy { display:flex; flex-shrink:0; gap:14px; padding-right:14px; animation:sketch-drift 85s linear infinite; }
.sketch-marquee-row:nth-child(3) .sketch-marquee-copy { animation-direction:reverse; animation-duration:95s; }
.sketch-marquee-copy a { width:235px; flex-shrink:0; display:flex; flex-direction:column; padding:16px; border:1.3px solid var(--ink); border-radius:3px 9px 4px 7px; background:#edf2ff66; color:var(--ink); text-decoration:none; }
.sketch-marquee-copy a:nth-child(even) { border-radius:8px 3px 7px 2px; background:var(--paper); }
.sketch-marquee-copy strong { font:24px var(--font-sketch); overflow-wrap:anywhere; }
.sketch-marquee-copy strong span { color:var(--accent); }
.sketch-marquee-copy p { font-size:12px; line-height:1.65; color:var(--muted); margin:8px 0 12px; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; min-height:40px; }
.sketch-marquee-copy small { display:flex; justify-content:space-between; font:16px var(--font-sketch); margin-top:auto; color:var(--accent); }
.sketch-marquee[data-paused] .sketch-marquee-copy, .sketch-marquee-row:is(:hover,:focus-within) .sketch-marquee-copy { animation-play-state:paused; }
.sketch-marquee-row[data-manual], .film[data-static] .sketch-marquee-row { overflow-x:auto; }
.sketch-marquee-row[data-manual] .sketch-marquee-copy, .film[data-static] .sketch-marquee-copy { animation:none; }
.sketch-marquee-row[data-manual] [aria-hidden], .film[data-static] .sketch-marquee-copy[aria-hidden] { display:none; }
@keyframes sketch-drift { to { transform:translateX(-100%); } }
@media(prefers-reduced-motion:reduce) { .sketch-marquee-copy { animation:none; } .sketch-marquee-row { overflow-x:auto; } .sketch-marquee-copy[aria-hidden], .sketch-marquee-heading button { display:none; } }
.sketch-marquee-copy .sketch-language { display:inline-flex; align-items:center; gap:7px; color:color-mix(in srgb, var(--language-color) 65%, #172036); }
.sketch-language::before { content:""; width:9px; height:9px; flex-shrink:0; background:var(--language-color); border:1px solid #17203645; border-radius:45% 55% 48% 52%; }
</style>
