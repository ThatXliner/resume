---
import { Font } from "astro:assets";
import "../styles/global.css";
import "../styles/notebook-site.css";

interface Props {
    title?: string;
    description?: string;
    /**
     * Social preview card. Must be set per page — without an explicit one,
     * scrapers pick the first large image in the document, which is how
     * /thelist ended up previewing as a NerdLens screenshot.
     */
    image?: string;
    /** Pins scroll-driven animations to their settled state, for QA captures. */
    noanim?: boolean;
}

const {
    title = "Bryan Hu — Founder & Developer",
    description = "Bryan Hu is a founder and full-stack developer building Billion (civic intelligence) and Quillium (version control for prose) — plus open-source Python tooling, award-winning robotics software, and creative work.",
    image = "/og/home.png",
    noanim,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" data-noanim={noanim ? "" : undefined}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#fffefb" />
        <meta name="color-scheme" content="light" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
        <Font cssVariable="--font-sans" preload />
        <Font cssVariable="--font-serif" preload={Astro.url.pathname === "/photography"} />
        <script
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id="2be13475-b999-4286-a9b3-6142c2df6136"></script>
    </head>
    <body>
        <slot />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        min-height: 100%;
    }
</style>
