---
import PlayablePiano from '../components/PlayablePiano.astro';
import Nav from '../components/Nav.astro';
import SkillGrid from '../components/SkillGrid.astro';
import Layout from '../layouts/Layout.astro';
import CommunityStory from '../components/CommunityStory.astro';
import StoryPath from '../components/StoryPath.astro';
import MusicStory from '../components/MusicStory.astro';
import sunset from '../assets/photography/road-to-sunset.webp';
import moon from '../assets/photography/moon-over-the-hills.webp';
import street from '../assets/photography/market-street.webp';
import { resume } from '../data/resume';
import '../styles/resume-film.css';
---
<Layout title="Bryan Hu — Developer, Photographer & Musician">
  <div class="film" id="top">
    <a class="skip-film" href="#index">Skip to résumé</a>
    <Nav />
    <div class="film-stage" aria-hidden="true"><canvas id="film-canvas"></canvas></div>
    <div class="film-status" role="status">Loading 3D models…</div>
    <main>
      <section class="film-chapter opening" id="intro" data-scene="0">
        <div class="chapter-frame">
          <div class="opening-heading"><h1>Hi, I’m<br/><em>Bryan.</em></h1><p class="opening-intro">I build apps and open-source tools.<br/>I also make photographs and music.</p><PlayablePiano />
          <div class="opening-foot"><a href="#build">Explore my work <span>↓</span></a><a class="resume-jump" href="#index">See my resume <span aria-hidden="true">↓</span></a></div></div>

        </div>
      </section>
      <section class="film-chapter" id="build" data-scene="1">
        <div class="chapter-frame"><div class="chapter-copy"><h2>From idea<br/>to <em>app.</em></h2><p class="body-copy">I build full-stack apps, from the interface to the systems behind it.</p><div class="project-links"><a href="/products/billion"><span>Billion</span><small>Follow bills, court rulings, and executive orders</small><b>↗</b></a><a href="/products/quillium"><span>Quillium</span><small>Version control for prose</small><b>↗</b></a></div></div></div>
      </section>
      <CommunityStory />
      <section class="film-chapter camera-chapter" id="observe" data-scene="3">
        <div class="chapter-frame"><div class="chapter-copy"><h2>Look<br/><em>closer.</em></h2><p class="body-copy">I photograph, operate cameras, and switch live productions. Then comes the editing, color grading, and sound.</p></div></div>
      </section>
      <section class="film-chapter gallery-chapter" id="frames" data-scene="4">
        <div class="chapter-frame"><div class="gallery-heading"><h2>Photographs</h2></div><div class="film-gallery"><a href="/photography"><img src={street.src} alt="Market Street, photographed by Bryan Hu" loading="lazy"/><span>Market Street</span></a><a href="/photography"><img src={sunset.src} alt="Road to sunset, photographed by Bryan Hu" loading="lazy"/><span>Road to sunset</span></a><a href="/photography"><img src={moon.src} alt="Moon over the hills, photographed by Bryan Hu" loading="lazy"/><span>Moon over the hills</span></a></div><p class="gallery-foot"><a class="text-link" href="/photography">View all photographs <span>↗</span></a></p></div>
      </section>
      <MusicStory />
      <section class="resume-index" id="index">
        <div class="index-heading"><h2>Résumé</h2><a class="resume-download" href="/resume.pdf" download="BryanHu_Resume.pdf">Download résumé PDF <span aria-hidden="true">↓</span></a><address class="resume-contact" id="contact"><a href={`mailto:${resume.email}`}>{resume.email}</a><div><a href={`https://github.com/${resume.github}`}>GitHub ↗</a><a href={`https://www.linkedin.com/in/${resume.linkedin}/`}>LinkedIn ↗</a></div></address><SkillGrid /></div>
        <div class="index-details"><h3>Selected recognition</h3><div class="award-row"><span>Congressional App Challenge 2025</span><b>3rd place / CA-19</b></div>{resume.awards.map(item => <a class="award-row" href={item.url}><span>{item.label}</span><b>↗</b></a>)}<h3>Robotics · FRC Team 3256</h3>{resume.frcAwards.map(award => <a class="award-row" href={award.url}><span>{award.label} ↗</span><b>{award.year}</b></a>)}</div>
      </section>
      <StoryPath />
    </main>
    <button class="motion-toggle" type="button" aria-pressed="false">Motion on</button>
  </div>
  <noscript><style>.film-status, .motion-toggle { display: none !important; }</style></noscript>
  <script>
    // Let content and lightweight controls paint before importing the 3D engine.
    const start = () => {
      const load = () => import('../lib/resume-film').then(({ initResumeFilm }) => initResumeFilm()).catch(() => {
        const status = document.querySelector<HTMLElement>('.film-status');
        if (status) status.hidden = true;
      });
      if ('requestIdleCallback' in window) window.requestIdleCallback(load, { timeout: 2000 });
      else setTimeout(load, 200);
    };
    requestAnimationFrame(() => requestAnimationFrame(start));
  </script>
</Layout>
