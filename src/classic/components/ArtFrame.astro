---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// One frame, used by both the gallery card and the piece page. When a piece
// has no image yet it renders an explicit empty frame rather than collapsing,
// so a half-finished gallery still reads as a gallery.
interface Props {
    image?: ImageMetadata;
    alt: string;
    kind: "code" | "photo" | "music";
    class?: string;
    sizes?: number;
}

const { image, alt, kind, class: className, sizes = 1200 } = Astro.props;

const emptyLabel = {
    code: "No still yet",
    photo: "No photograph yet",
    music: "No cover art yet",
}[kind];
---

{
    image ? (
        <Image
            src={image}
            alt={alt}
            width={sizes}
            densities={[1, 2]}
            loading="lazy"
            draggable="false"
            class:list={[
                "aspect-16/10 w-full object-cover select-none",
                className,
            ]}
        />
    ) : (
        <div
            class:list={[
                "flex aspect-16/10 w-full items-center justify-center bg-surface-2",
                className,
            ]}
        >
            <span class="t-caption">{emptyLabel}</span>
        </div>
    )
}
