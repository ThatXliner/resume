---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ArtFrame from "@/classic/components/ArtFrame.astro";
import { photographs } from "@/classic/data/photography";

interface Props {
    pieces: CollectionEntry<"art">[];
}

const { pieces } = Astro.props;

// Keep these bodies of work ready to restore, but leave the art landing page
// focused on photography for now.
const showMusicAndCode = false;

// Grouped rather than filtered: three sections need no JavaScript and no tab
// state, and the whole body of work is visible in one scroll.
//
// `intro` is where a section argues for itself. Only Code needs one — a
// photography section doesn't have to explain why photographs are art, but
// putting programs next to them does need a case made.
const groups = [
    {
        kind: "code" as const,
        label: "Code",
        note: "Programming is an art.",
        intro: "PLACEHOLDER — this is where you argue that code is a medium and not just a tool: why a program can be a piece the same way a photograph is. It belongs to this section rather than the top of the page, so it reads as the case for the work sitting underneath it. Yours to write; replace this string in src/components/ArtIndex.astro.",
    },
    { kind: "music" as const, label: "Music", note: "For the ear." },
];

const featuredPhotoTitles = [
    "Firmament",
    "The Lull at Zephyr Cove",
    "Counter Service",
];
const featuredPhotos = featuredPhotoTitles
    .map((title) => photographs.find((photo) => photo.title === title))
    .filter((photo) => photo !== undefined);

const byKind = (kind: string) =>
    pieces
        .filter((piece) => piece.data.kind === kind)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatYear = (date: Date) => date.getFullYear();
---

{
    showMusicAndCode && groups.map((group) => {
        const items = byKind(group.kind);
        if (items.length === 0) return null;
        return (
            <section class="mx-auto max-w-[1180px] px-gutter pt-16 md:pt-24">
                <div class="reveal flex items-baseline justify-between gap-4 border-b border-hairline pb-4">
                    <h2 class="t-headline">{group.label}</h2>
                    <p class="t-caption">{group.note}</p>
                </div>

                {group.intro && (
                    <div class="essay reveal mt-7">
                        <blockquote>{group.intro}</blockquote>
                    </div>
                )}

                <div class="mt-8 grid gap-5 md:grid-cols-2">
                    {items.map((piece) => (
                        <a
                            href={`/classic/art/${piece.id}`}
                            class="plane plane-hover reveal group flex flex-col overflow-hidden"
                        >
                            <ArtFrame
                                image={piece.data.image}
                                alt={piece.data.title}
                                kind={piece.data.kind}
                                class="border-b border-hairline"
                            />

                            <div class="flex flex-1 flex-col p-6 md:p-7">
                                <div class="flex items-baseline justify-between gap-4">
                                    <h3 class="t-headline text-[1.125rem] md:text-[1.25rem]">
                                        {piece.data.title}
                                    </h3>
                                    <span class="t-caption tnum shrink-0">
                                        {formatYear(piece.data.date)}
                                    </span>
                                </div>

                                <p class="t-body mt-2.5 text-[0.9375rem]">
                                    {piece.data.blurb}
                                </p>

                                <div class="mt-6 flex items-center gap-4">
                                    <span class="a-link text-[0.875rem]">
                                        Read
                                        <span class="chev" aria-hidden="true">
                                            &rsaquo;
                                        </span>
                                    </span>
                                    {piece.data.medium && (
                                        <span class="t-caption ml-auto">
                                            {piece.data.medium}
                                        </span>
                                    )}
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        );
    })
}

<section class="mx-auto max-w-[1180px] px-gutter pt-16 md:pt-24">
    <div class="reveal flex items-baseline justify-between gap-4 border-b border-hairline pb-4">
        <h2 class="t-headline">Photography</h2>
        <p class="t-caption">To reveal God's beauty.</p>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
            featuredPhotos.map((photo) => (
                <button
                    type="button"
                    class="featured-photo plane plane-hover reveal group w-full cursor-zoom-in overflow-hidden text-left"
                    data-src={photo.image.src}
                    data-alt={photo.alt}
                    data-title={photo.title}
                    data-width={photo.image.width}
                    data-height={photo.image.height}
                    aria-haspopup="dialog"
                    aria-controls="featured-photo-viewer"
                    aria-label={`Open ${photo.title}`}
                >
                    <Image
                        src={photo.image}
                        alt={photo.alt}
                        widths={[480, 800]}
                        sizes="(min-width: 768px) 33vw, 90vw"
                        loading="lazy"
                        draggable="false"
                        class="aspect-[4/3] w-full object-cover select-none transition-transform duration-500 ease-out motion-safe:group-hover:scale-[1.015] motion-reduce:transition-none"
                    />
                    <div class="border-t border-hairline p-5">
                        <div class="flex items-baseline justify-between gap-3">
                            <h3 class="text-[1rem] font-semibold">{photo.title}</h3>
                            <span class="t-caption shrink-0">
                                {new Date(`${photo.date} 1`).getFullYear()}
                            </span>
                        </div>
                        <p class="t-caption mt-2">{photo.camera}</p>
                    </div>
                </button>
            ))
        }
    </div>

    <a href="/classic/photography" class="a-link reveal mt-8 text-[0.9375rem]">
        View the full photography gallery
        <span class="chev" aria-hidden="true">&rsaquo;</span>
    </a>
</section>

<dialog
    id="featured-photo-viewer"
    aria-labelledby="featured-photo-viewer-title"
    class="m-auto h-dvh max-h-none w-screen max-w-none border-0 bg-black/94 p-0 text-fg backdrop:bg-black/94"
>
    <form method="dialog">
        <button
            class="fixed top-5 right-5 z-10 flex size-11 items-center justify-center rounded-full bg-black/60 text-2xl text-white transition-colors hover:bg-white hover:text-black"
            autofocus
            aria-label="Close photograph"
        >
            &times;
        </button>
    </form>
    <div data-viewer-backdrop class="flex h-full w-full flex-col items-center justify-center gap-4 p-5 md:p-10">
        <div data-viewer-frame class="relative shrink-0"></div>
        <p id="featured-photo-viewer-title" class="t-caption text-fg-muted"></p>
    </div>
</dialog>

<script>
    import { setupPhotoViewer } from "@/classic/lib/photo-viewer";

    setupPhotoViewer("#featured-photo-viewer", "@/components/.featured-photo");
</script>
