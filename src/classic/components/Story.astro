---
import { Icon } from "astro-icon/components";

const chapters = [
    {
        era: "Roots",
        title: "I learned to build by shipping to strangers.",
        body: "Python libraries on PyPI, with real users and real bug reports: async UDP in aioudp, HTML-to-Markdown in unmarkd, project tooling in pyt2 and idae. Publishing them taught me everything around the code — docs, CI, semver, and how to tell someone their feature request is out of scope.",
        links: [
            { label: "aioudp", url: "https://github.com/ThatXliner/aioudp" },
            { label: "unmarkd", url: "https://github.com/ThatXliner/unmarkd" },
        ],
    },
    {
        era: "Teams",
        title: "Then I learned what a deadline with other people feels like.",
        body: "FRC Team 3256: elevator subsystems, 3D simulation, anti-tip logic, and the scouting app. Two seasons, seven awards, and a lasting respect for code that has to work on the first try in front of a crowd.",
        links: [{ label: "Team 3256", url: "https://github.com/Team3256" }],
    },
    {
        era: "Leadership",
        title: "Someone had to run it, so I did.",
        body: "I was CEO of VC Assist, a student-run non-profit maintaining my school's digital infrastructure, and I founded the VCSD software development club — where I wrote the curriculum and built the teaching tools, because nobody else was going to.",
        links: [
            { label: "VC Assist", url: "https://vcassist.org" },
            { label: "VCSD Club", url: "https://vcsdclub.org" },
        ],
    },
    {
        era: "Proof",
        title: "Competitions were the reality check.",
        body: "3rd place in the 2025 Congressional App Challenge for CA-19, top 2% of picoCTF 2026 at 174th out of 8,747, and USACO Silver. The App Challenge entry mattered most, because it turned into the thing I do now.",
        links: [],
    },
    {
        era: "Now",
        title: "That entry became a company.",
        body: "It grew into Billion, heading to iOS and Android. Quillium came out of a different frustration entirely. I'm all in on both, which is a nicer way of saying I have stopped starting new projects.",
        links: [
            { label: "Billion", url: "https://www.billion-news.app/" },
            { label: "Quillium", url: "https://quillium.bryanhu.com/" },
        ],
    },
];

const awards = [
    {
        label: "3rd Place — Congressional App Challenge, CA-19",
        year: "2025",
        url: "https://www.congressionalappchallenge.us/",
    },
    {
        label: "Creativity Award — Daly Division, FRC Championship",
        year: "2025",
        url: "https://www.thebluealliance.com/event/2025dal#awards",
    },
    {
        label: "Excellence in Engineering — Contra Costa Regional",
        year: "2025",
        url: "https://www.thebluealliance.com/event/2025capt#awards",
    },
    {
        label: "Innovation in Control — Ventura County Regional",
        year: "2025",
        url: "https://www.thebluealliance.com/event/2025cave#awards",
    },
    {
        label: "Engineering Inspiration — San Francisco Regional",
        year: "2025",
        url: "https://www.thebluealliance.com/event/2025casf#awards",
    },
    {
        label: "Judges' Award — Capital City Classic",
        year: "2025",
        url: "https://www.thebluealliance.com/event/2025cacc#awards",
    },
    {
        label: "picoCTF — 174th of 8,747 nationally",
        year: "2026",
        url: "https://picoctf.org/",
    },
    { label: "USACO Silver", year: "2023", url: "https://usaco.org/" },
    {
        label: "Regional Finalists — Silicon Valley Regional",
        year: "2024",
        url: "https://www.thebluealliance.com/event/2024casj#awards",
    },
    {
        label: "Engineering Inspiration — Arizona Valley Regional",
        year: "2024",
        url: "https://www.thebluealliance.com/event/2024azva#awards",
    },
    // Newest first. Sort is stable, so entries sharing a year keep the order
    // they're written in above.
].sort((a, b) => Number(b.year) - Number(a.year));
---

<section id="story" class="relative border-t border-hairline">
    <div
        class="mx-auto max-w-[1180px] px-gutter pt-24 pb-4 text-center md:pt-36"
    >
        <p class="t-eyebrow reveal">The story so far</p>
        <h2 class="t-title mx-auto mt-3 max-w-[24ch] text-balance">
            <span class="mask mask-scroll"><span>How I got&nbsp;here.</span></span>
        </h2>
    </div>

    <div class="journey">
        <div class="journey-note" aria-hidden="true">a few turns along the way <span>↴</span></div>
        <svg class="journey-trail" aria-hidden="true" fill="none">
            <path class="trail-guide" />
            <path class="trail-ink" />
            <g class="trail-pen">
                <circle r="3" class="pen-dot" />
                <path d="M0 0 5 -17 12 -23 17 -18 11 -11Z M5 -17 11 -11" />
            </g>
        </svg>
        {
            chapters.map((chapter, i) => (
                <article class="chapter" data-chapter={i}>
                    <div class="chapter-margin">
                        <span class="chapter-number" aria-hidden="true">0{i + 1}</span>
                        <p class="chapter-era">{chapter.era}</p>
                        <svg class="chapter-sketch" viewBox="0 0 100 90" fill="none" aria-hidden="true">
                            {i === 0 && <path pathLength="1" d="M20 25 Q46 20 78 25 L76 65 Q46 62 19 66 Z M20 34 L77 34 M26 29 L28 29 M33 29 L35 29 M40 29 L42 29 M36 43 L28 49 36 55 M59 43 L67 49 59 55 M51 40 L44 58 M25 73 Q51 70 73 73" />}
                            {i === 1 && <path pathLength="1" d="M25 31 Q50 27 75 32 L77 63 24 64 Z M49 29 L50 19 M46 15 Q50 9 54 15 Q54 20 50 20 Q45 19 46 15 M33 43 L39 43 39 49 33 49 Z M61 42 L67 42 67 48 61 48 Z M38 57 Q50 61 63 56 M23 40 L16 41 15 55 24 55 M77 40 L84 41 85 55 77 55 M34 65 L33 74 M65 64 L67 74 M26 76 L40 76 M60 76 L74 76" />}
                            {i === 2 && <path pathLength="1" d="M44 20 Q50 9 57 20 Q60 32 50 33 Q41 32 44 20 M35 50 Q35 36 50 36 Q66 36 66 50 Z M23 59 Q28 50 33 59 Q36 68 28 69 Q20 68 23 59 M14 83 Q14 72 28 72 Q42 72 42 83 M67 58 Q73 49 78 58 Q81 68 73 69 Q65 67 67 58 M59 83 Q59 72 73 72 Q87 72 87 83 M50 52 L50 62 M43 62 L57 62" />}
                            {i === 3 && <path pathLength="1" d="M33 20 Q50 17 67 20 L64 42 Q60 53 50 55 Q39 53 36 42 Z M33 25 L22 24 Q19 43 38 43 M67 25 L79 24 Q82 42 63 43 M50 55 L50 70 M38 72 Q50 68 63 72 L65 78 35 78 Z M50 25 L53 32 60 33 55 38 56 45 50 41 44 45 45 38 40 33 47 32 Z M17 12 L22 17 M80 12 L76 17" />}
                            {i === 4 && <path pathLength="1" d="M34 56 Q40 28 74 15 Q79 47 51 65 Z M34 56 L22 55 Q24 39 44 35 M51 65 L53 78 Q69 71 65 52 M55 31 Q62 25 66 32 Q68 40 60 41 Q52 40 55 31 M31 63 Q19 67 18 80 Q33 78 38 68 M26 65 L18 72 M43 72 L38 82 M16 41 L10 41 M13 38 L13 44 M79 65 L89 65 M84 60 L84 70" />}
                        </svg>
                    </div>
                    <div class="chapter-copy">
                        <h3>{chapter.title}</h3>
                        <p class="t-body mt-5">{chapter.body}</p>
                        {chapter.links.length > 0 && (
                            <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
                                {chapter.links.map((link) => (
                                    <a href={link.url} target="_blank" rel="noopener noreferrer" class="a-link text-[0.875rem]">
                                        {link.label}<span class="chev" aria-hidden="true">&rsaquo;</span>
                                    </a>
                                ))}
                            </div>
                        )}
                    </div>
                </article>
            ))
        }
        <p class="journey-end"><span aria-hidden="true">↳</span> still writing this part.</p>
    </div>

    <!-- ══ Awards ═══════════════════════════════════════════════════════ -->
    <div class="mx-auto max-w-[52rem] px-gutter pt-16 pb-24 md:pt-24 md:pb-36">
        <div class="reveal flex items-baseline justify-between gap-4">
            <h3 class="t-headline">The receipts.</h3>
            <span class="t-caption tnum">{awards.length} awards</span>
        </div>

        <ul class="mt-8">
            {
                awards.map((award) => (
                    <li class="reveal border-t border-hairline">
                        <a
                            href={award.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group flex items-baseline gap-4 py-3.5"
                        >
                            <span class="text-[0.9375rem] text-fg-muted transition-colors group-hover:text-fg">
                                {award.label}
                            </span>
                            <span
                                aria-hidden="true"
                                class="mb-1 min-w-4 flex-1 border-b border-hairline"
                            />
                            <span class="t-caption tnum shrink-0">
                                {award.year || "—"}
                            </span>
                            <Icon
                                name="lucide:arrow-up-right"
                                class="size-3.5 shrink-0 text-fg-dim opacity-0 transition-opacity group-hover:opacity-100"
                            />
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<script>
    import { initStoryMotion } from '@/classic/lib/story-motion';
    initStoryMotion();
</script>

<style>
    .journey {
        --ink: #82b7f6;
        position: relative;
        max-width: 960px;
        margin: 4rem auto 0;
        padding: 70px 30px 80px;
    }
    .journey-note, .journey-end {
        font-family: var(--font-serif), Georgia, serif;
        font-style: italic;
        font-size: 16px;
        color: var(--ink);
    }
    .journey-note { position: absolute; top: 0; left: 182px; transform: rotate(-5deg); }
    .journey-note span { display: inline-block; margin-left: 8px; font-size: 28px; transform: rotate(30deg); }
    .journey-trail { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; stroke-linecap: round; stroke-linejoin: round; }
    .trail-guide { stroke: var(--ink); stroke-width: 1; opacity: .13; }
    .trail-ink { stroke: var(--ink); stroke-width: 1.7; }
    .trail-pen { stroke: var(--ink); stroke-width: 1.4; fill: #000; opacity: 0; }
    .pen-dot { fill: var(--ink); stroke: none; }
    .chapter { position: relative; display: grid; grid-template-columns: 180px 1fr; column-gap: 60px; padding: 36px 0 170px; }
    .chapter-margin { position: relative; padding-left: 0; }
    .chapter-number { font-size: 12px; font-family: monospace; color: var(--ink); }
    .chapter-era { margin-top: 7px; font-size: 13px; font-weight: 500; color: var(--color-fg-muted); }
    .chapter-sketch { width: 90px; height: 81px; margin-top: 38px; margin-left: -14px; stroke: var(--ink); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transform: rotate(-6deg); }
    .chapter:nth-of-type(even) .chapter-sketch { transform: rotate(5deg); }
    .chapter-copy h3 { max-width: 23ch; font-size: clamp(1.65rem, 3vw, 2.25rem); line-height: 1.18; letter-spacing: -.035em; font-weight: 550; text-wrap: balance; }
    .chapter-copy .t-body { max-width: 52ch; }
    .chapter-copy .a-link { position: relative; }
    .chapter-copy .a-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 5px; border-top: 1px solid currentColor; border-radius: 50%; transform: scaleX(0) rotate(-2deg); transform-origin: left; transition: transform .35s ease; }
    .chapter-copy .a-link:is(:hover, :focus-visible)::after { transform: scaleX(1) rotate(-2deg); }
    .journey-end { position: absolute; left: 162px; bottom: 17px; transform: rotate(-3deg); }
    .journey-end span { margin-right: 10px; }
    @media (prefers-reduced-motion: no-preference) {
        .motion-ready .chapter-copy { opacity: calc(.65 + var(--chapter-progress, 1) * .35); transform: translateY(calc((1 - var(--chapter-progress, 1)) * 22px)); }
        .motion-ready .chapter-sketch path { stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--chapter-progress, 1)); }
        .chapter-era { transition: color .4s; }
        .is-written .chapter-era { color: var(--color-fg); }
    }
    @media (min-width: 700px) {
        .chapter:nth-of-type(even) { grid-template-columns: 1fr 180px; }
        .chapter:nth-of-type(even) .chapter-margin { grid-column: 2; grid-row: 1; text-align: right; }
        .chapter:nth-of-type(even) .chapter-copy { grid-column: 1; grid-row: 1; }
        .chapter:nth-of-type(even) .chapter-sketch { display: block; margin-left: auto; margin-right: -14px; }
    }
    @media (max-width: 699px) {
        .journey { margin: 3rem 20px 0; padding: 65px 0 70px; }
        .journey-note { left: 45px; font-size: 14px; }
        .chapter { grid-template-columns: 1fr; padding: 30px 0 110px 48px; gap: 18px; }
        .chapter:nth-of-type(even) { padding-left: 0; padding-right: 48px; }
        .chapter-margin { display: flex; align-items: baseline; gap: 12px; }
        .chapter-era { margin: 0; }
        .chapter-sketch { position: absolute; right: 0; top: -17px; width: 48px; height: 44px; margin: 0; }
        .chapter-copy h3 { font-size: 1.65rem; }
        .chapter-copy .t-body { font-size: 1rem; }
        .journey-end { left: 45px; font-size: 14px; }
    }
    :global(html[data-noanim]) .chapter-copy { opacity: 1; transform: none; }
    :global(html[data-noanim]) .chapter-sketch path { stroke-dashoffset: 0; }
</style>
