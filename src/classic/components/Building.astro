---
import PhoneFrame from "@/classic/components/ui/PhoneFrame.astro";
import WindowFrame from "@/classic/components/ui/WindowFrame.astro";
import billionBrowse from "@/assets/products/billion-browse.png";
import billionFeed from "@/assets/products/billion-feed.png";
import quilliumRevision from "@/assets/products/quillium-revision.png";

const ventures = [
    {
        id: "billion",
        name: "Billion",
        url: "https://www.billion-news.app/",
        displayUrl: "billion-news.app",
        headline:
            "Most people find out what their government did after it has already changed their life.",
        body: "Browsable summaries of bills, executive orders, and court rulings. It started as my Congressional App Challenge entry and outgrew the competition.",
        cta: "Get early access",
        points: [
            {
                title: "Dual-Lens view",
                detail: "Progressive and conservative readings of the same bill, side by side.",
            },
            {
                title: "Your ballot",
                detail: "Track what you're actually voting on, and who is actually on it.",
            },
            {
                title: "Sourced, always",
                detail: "Every summary cites primary documents.",
            },
        ],
        // Billion leads with text on the left; Quillium mirrors it.
        reversed: false,
        // Two phones need equal columns; a wide window screenshot needs more.
        grid: "md:grid-cols-2",
    },
    {
        id: "quillium",
        name: "Quillium",
        url: "https://quillium.bryanhu.com/",
        displayUrl: "quillium.bryanhu.com",
        headline: "Version control for prose.",
        body: "Draft a sentence three ways and decide later. Every version stays inside the document instead of being overwritten. I built it because I kept losing the better draft.",
        cta: "Download for macOS",
        points: [
            {
                title: "Branching drafts",
                detail: "Alternative versions live in the document until you pick one.",
            },
            {
                title: "Local-only",
                detail: "One SQLite file on your disk. Crash-safe, and offline by default.",
            },
            {
                title: "Anchored notes",
                detail: "Comments attach to the exact words they're about, not the margin.",
            },
        ],
        reversed: true,
        // Art sits in column one when reversed, so the wider track leads.
        grid: "md:grid-cols-[1.12fr_0.88fr]",
    },
];
---

<section id="building" class="relative">
    <!-- Section opener. One idea, centered, with room around it. -->
    <div
        class="mx-auto max-w-[1180px] px-gutter pt-24 pb-4 text-center md:pt-36"
    >
        <p class="t-eyebrow reveal">What I'm building</p>
        <h2 class="t-title mx-auto mt-3 max-w-[24ch] text-balance">
            <span class="mask mask-scroll"
                ><span>My current projects</span></span
            >
        </h2>
        <p class="t-lede reveal mx-auto mt-5 max-w-[46ch] text-balance">
        Stuff I'm currently focused on building
            <!--One makes your government legible. The other keeps every draft you
            were afraid to delete.-->
        </p>
    </div>

    {
        ventures.map((venture) => (
            <article class="mx-auto max-w-[1180px] px-gutter pt-20 pb-8 md:pt-28 md:pb-16">
                <div
                    class:list={[
                        "grid items-center gap-12 md:gap-16",
                        venture.grid,
                    ]}
                >
                    {/* ── Copy ── */}
                    <div class:list={[venture.reversed && "md:order-2"]}>
                        <p class="t-eyebrow reveal text-accent">
                            {venture.name}
                        </p>
                        <h3 class="t-headline reveal mt-2.5 text-balance">
                            {venture.headline}
                        </h3>
                        <p class="t-body reveal mt-4 max-w-[46ch]">
                            {venture.body}
                        </p>

                        <div class="reveal mt-7 flex flex-wrap items-center gap-x-7 gap-y-4">
                            <a
                                href={venture.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="btn btn-primary"
                            >
                                {venture.cta}
                            </a>
                            <a
                                href={venture.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="a-link"
                            >
                                {venture.displayUrl}
                                <span class="chev" aria-hidden="true">
                                    &rsaquo;
                                </span>
                            </a>
                        </div>

                        <ul class="mt-9">
                            {venture.points.map((point) => (
                                <li class="reveal border-t border-hairline py-4">
                                    <h4 class="text-[0.9375rem] font-semibold">
                                        {point.title}
                                    </h4>
                                    <p class="t-caption mt-1 max-w-[44ch]">
                                        {point.detail}
                                    </p>
                                </li>
                            ))}
                        </ul>
                    </div>

                    {/* ── The real app, in frames we draw ourselves ── */}
                    <div
                        class:list={[
                            "approach",
                            venture.reversed && "md:order-1",
                        ]}
                    >
                        {venture.id === "billion" ? (
                            <div class="flex items-start justify-center gap-4 sm:gap-6">
                                <PhoneFrame
                                    src={billionBrowse}
                                    alt="Billion's Browse tab, listing recent bills with plain-language titles"
                                    class="drift-slow"
                                />
                                <PhoneFrame
                                    src={billionFeed}
                                    alt="A Billion bill summary with its spectrum view and source link"
                                    class="drift-fast mt-10 sm:mt-14"
                                />
                            </div>
                        ) : (
                            <WindowFrame
                                src={quilliumRevision}
                                alt="Quillium showing a passage with an active revision branch and an anchored comment"
                                title="A Tale of Two Cities — draft"
                                class="drift-slow"
                            />
                        )}
                    </div>
                </div>
            </article>
        ))
    }
</section>
